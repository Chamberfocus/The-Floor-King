# Floor King CRM — environment variables
# Copy this file to .env.local and fill in the real values from your Supabase project.
# (Project Settings -> API in the Supabase dashboard)

# Your project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" / "publishable" key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The secret "service_role" / "secret" key (SERVER ONLY — never expose to the browser).
# Used later for admin tasks like inviting staff. Optional for the first login test.
SUPABASE_SERVICE_ROLE_KEY=

# The public base URL of the app (used for auth email redirects).
# Local dev: http://localhost:3000 — in production set to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
